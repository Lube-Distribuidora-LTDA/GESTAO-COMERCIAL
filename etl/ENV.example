# Copie este arquivo, renomeie a copia para "ENV" (sem extensao, exatamente
# esse nome) e coloque na MESMA pasta dos scripts (etl/).
# NUNCA compartilhe o arquivo "ENV" depois de preenchido (ele guarda senha).

# --- Oracle / WinThor -------------------------------------------------
ORACLE_HOST=ip_do_servidor_oracle
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=nome_do_service
ORACLE_USER=usuario_de_leitura
ORACLE_PASSWORD=coloque_a_senha_aqui

# --- Supabase (projeto DATA WAREHOUSE) --------------------------------
# Usando o "Session pooler" (recomendado quando a maquina que roda o
# script esta numa rede IPv4 comum, como a maioria das redes de empresa —
# a conexao "Direct" do Supabase usa IPv6 por padrao e pode nao funcionar
# sem um complemento pago).
#
# Campos separados (em vez de uma unica URL) de proposito: a senha gerada
# pelo Supabase quase sempre tem caracteres especiais (@, /, %, #...) que
# quebrariam uma URL de conexao se nao fossem codificados. Assim, cole a
# senha exatamente como copiou, sem se preocupar com isso.
#
# IMPORTANTE: coloque a senha ENTRE ASPAS DUPLAS, assim: "sua_senha_aqui".
# Isso evita um problema comum: se a senha tiver um caractere "#" e nao
# estiver entre aspas, tudo que vem depois dele na linha e ignorado (tratado
# como comentario), cortando a senha pela metade sem nenhum aviso.
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.id_do_projeto
SUPABASE_DB_PASSWORD="cole_a_senha_aqui"

# --- Recortes das consultas (opcional) ----------------------------------
# Sao os filtros que o Power BI tinha escritos a mao dentro do SQL. Deixe
# comentado para usar o mesmo recorte do BI original.
# MARGEM_DATA_INICIAL=2023-01-01
# MARGEM_FILIAIS=1
# COMISSAO_DATA_INICIAL=2025-01-01
# COMISSAO_FILIAIS=1,7,10,11,12
# DEVOLUCAO_DATA_INICIAL=2025-01-01

# --- Opcional -----------------------------------------------------------
LOG_LEVEL=INFO
